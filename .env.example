# Supabase
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"
VITE_SUPABASE_URL="https://your-project.supabase.co"
# Use "direct" with the existing anon INSERT policy. Switch to "edge" only
# after capture-lead has been deployed and verified in this Supabase project.
VITE_LEAD_CAPTURE_MODE="direct"

# Optional: paste the public URL from Google Calendar > Appointment schedules.
# Until configured, the site keeps the existing Cal.com consultation fallback.
VITE_GOOGLE_APPOINTMENT_SCHEDULE_URL=""

# Microsoft Clarity (Data Export API)
# Generate at: clarity.microsoft.com/projects/view/vf1hpu63ir/settings/api
# Valid dimensions: OS, Device, Browser, Country (max numOfDays=3)
CLARITY_API_TOKEN="your-clarity-jwt-token"
